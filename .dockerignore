# Что не должно попадать в образ.
#
# Без этого файла `COPY . .` затягивает внутрь всё подряд: файл .env с
# секретным ключом и паролем от базы, рабочую базу данных, каталог .git со
# всей историей и локальное виртуальное окружение. Образ раздувается на
# сотни мегабайт, а секреты остаются в его слоях — их видно любому, кто
# получит образ, даже если файл потом удалить следующей командой.

# --- Секреты и данные -------------------------------------------------------
.env
*.env
!.env.example

db.sqlite3
db.sqlite3-journal
db.sqlite3-wal
db.sqlite3-shm

# Фотографии товаров подключаются томом, в образе им не место
media/
backups/
logs/

# --- Окружение и сборка -----------------------------------------------------
venv/
.venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Статику собирает сам Dockerfile
staticfiles/

# --- Разработка -------------------------------------------------------------
.git/
.gitignore
.github/
.vscode/
.idea/
*.swp

.coverage
htmlcov/
.pytest_cache/
.tox/

# --- Прочее -----------------------------------------------------------------
*.log
.DS_Store
Thumbs.db
