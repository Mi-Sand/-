# ============================================================================
# Система складского учёта ООО «ЛЕКО» — Конфигурация
# ============================================================================
# Скопируйте этот файл в .env и заполните свои значения

# === Django ===
# ВАЖНО: сгенерируйте свой уникальный ключ! Этим ключом подписываются
# сессии пользователей. Значение ниже — пример, его нужно заменить.
# Сгенерировать новый:
#   python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(60)))"
SECRET_KEY=ЗАМЕНИТЕ-НА-СВОЙ-СЛУЧАЙНЫЙ-КЛЮЧ-НЕ-ОСТАВЛЯЙТЕ-ЭТУ-СТРОКУ

# DEBUG=True только для разработки. На рабочем сервере обязательно False:
# при True посторонним видны код и структура базы при любой ошибке.
DEBUG=True

# === База данных ===
# Режим: postgres или sqlite
#
# postgres — рекомендуется ВСЕГДА, когда с системой работает больше
#            одного человека (SQLite блокирует базу при записи, и
#            одновременная работа нескольких пользователей ломается).
# sqlite   — только для быстрой пробы на одном компьютере.
DB_ENGINE=postgres

# PostgreSQL параметры (используются только при DB_ENGINE=postgres)
DB_NAME=warehouse_db
DB_USER=warehouse_user
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432

# === Почта (Email) ===
# 
# Система отправляет уведомления:
# 1. При падении остатка материала ниже минимума
# 2. При завершении инвентаризации с выявленными недостачами
#
# EMAIL_BACKEND — способ отправки письма:

# РАЗВИТИЕ (письма выводятся в консоль):
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=warehouse@leko.example
WAREHOUSE_MANAGER_EMAIL=manager@leko.example

# PRODUCTION С GMAIL:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=warehouse@gmail.com
# EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx (App Password, не обычный пароль!)
# DEFAULT_FROM_EMAIL=warehouse@leko.example
# WAREHOUSE_MANAGER_EMAIL=manager@leko.example
#
# Как получить App Password для Gmail:
# 1. Включить двухфакторную аутентификацию на аккаунте Google
# 2. Перейти на https://myaccount.google.com/apppasswords
# 3. Выбрать "Mail" и "Windows Computer"
# 4. Скопировать 16-символьный пароль и вставить выше

# PRODUCTION С ЯНДЕКС.ПОЧТОЙ:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=warehouse@yandex.ru
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=warehouse@leko.example
# WAREHOUSE_MANAGER_EMAIL=manager@leko.example

# PRODUCTION С СОБСТВЕННЫМ SMTP СЕРВЕРОМ:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=mail.leko.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_HOST_USER=warehouse@leko.ru
# EMAIL_HOST_PASSWORD=secure-password
# DEFAULT_FROM_EMAIL=warehouse@leko.ru
# WAREHOUSE_MANAGER_EMAIL=manager@leko.ru

# PRODUCTION С SENDGRID:
# EMAIL_BACKEND=sendgrid_backend.SendgridBackend
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=warehouse@leko.example
# WAREHOUSE_MANAGER_EMAIL=manager@leko.example

# === Размещение ===
ALLOWED_HOSTS=localhost,127.0.0.1

# === Локализация ===
LANGUAGE_CODE=ru-ru
TIME_ZONE=Europe/Moscow
