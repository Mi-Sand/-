# ============================================================================
#  Настройки системы складского учёта ООО «ЛЕКО»
# ============================================================================
#
#  Скопируйте этот файл в .env и правьте копию, а не этот:
#
#      cp .env.example .env            # Linux/macOS
#      Copy-Item .env.example .env     # Windows PowerShell
#
#  Файл .env в репозиторий не попадает (указан в .gitignore): в нём пароли
#  и ключ конкретной установки.
#
#  После правки проверьте настройки одной командой:
#
#      python manage.py checksetup
#
#  Этот же файл читает docker compose — пароль базы и ключ он берёт отсюда.
# ============================================================================


# ============================================================================
#  ОБЯЗАТЕЛЬНОЕ
# ============================================================================

# --- Секретный ключ ---------------------------------------------------------
#
# Им подписываются сессии сотрудников. С общеизвестным ключом посторонний
# может подделать сессию администратора, поэтому в боевом режиме система не
# запустится, пока ключ не задан.
#
# Сгенерировать свой:
#
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
#
# Вставьте вывод команды сюда. Ключ никому не показывайте.
SECRET_KEY=

# --- Отладочный режим -------------------------------------------------------
#
# True  — разработка на своём компьютере: подробные страницы ошибок.
# False — любой сервер, к которому имеют доступ другие люди.
#
# При True страница ошибки показывает исходный код, значение SECRET_KEY и
# пароль от базы. Увидит её каждый, кто откроет систему в браузере, —
# достаточно любой ошибки на любой странице.
#
# Ещё при True не действует ALLOWED_HOSTS: принимаются запросы с любых
# адресов.
DEBUG=False

# --- Адреса, по которым открывают систему ------------------------------------
#
# Через запятую, без пробелов и без http://. Запрос с адреса, которого
# здесь нет, получит «Bad Request (400)».
#
#   только этот компьютер:          localhost,127.0.0.1
#   плюс доступ по локальной сети:  localhost,127.0.0.1,192.168.1.50
#   плюс доменное имя:              localhost,127.0.0.1,sklad.leko.local
#
# Свой адрес в сети: ipconfig (Windows) или ip a (Linux).
ALLOWED_HOSTS=localhost,127.0.0.1


# ============================================================================
#  БАЗА ДАННЫХ
# ============================================================================
#
# sqlite   — ничего дополнительно ставить не нужно, вся база в одном файле
#            db.sqlite3. Подходит для одного компьютера и небольшого склада.
#            Резервная копия — обычное копирование файла при остановленной
#            системе.
#
# postgres — отдельная СУБД. Нужна, когда с системой одновременно работают
#            несколько человек: SQLite при записи блокирует базу, и запросы
#            начинают ждать друг друга.
# Порядок перехода на PostgreSQL — в WINDOWS_SETUP.md, раздел
# «Переход на PostgreSQL». Данные переносит команда topostgres.
# Сначала прочтите там же, когда переход нужен, а когда нет: на нынешних
# объёмах SQLite быстрее, а её узкое место уже устранено настройкой.
# --- Работа по HTTPS ---------------------------------------------------------
#
# Включать только когда впереди стоит nginx с сертификатом и HTTPS
# действительно работает. Иначе система закроет себе вход: браузер уйдёт на
# адрес, которого нет, а куки с пометкой «только по защищённому соединению»
# не дойдут. Порядок целиком — в HTTPS.md.
#
# Признак этой ошибки: браузер пишет «Этот сайт не может обеспечить
# безопасное подключение» (ERR_SSL_PROTOCOL_ERROR), а в окне запуска видно
# «You're accessing the development server over HTTPS, but it only supports
# HTTP». Лечится возвратом USE_HTTPS=False и перезапуском.
#
# Второй признак, совсем не похожий на первый: страница входа открывается,
# но «Войти» отвечает «Ошибка проверки CSRF. Запрос отклонён». Так бывает,
# когда впереди стоит nginx и передаёт системе «соединение защищено», а
# сотрудник открыл её по обычному http: куки уходят с пометкой «только по
# защищённому соединению», браузер их не сохраняет, и входить нечем.
# Лечится тем же — либо USE_HTTPS=False, либо открывать по https.
#
# С сервером разработки (manage.py runserver) включать нельзя никогда: он
# говорит только по http, и перенаправление вести будет некуда. При таком
# сочетании система теперь предупреждает прямо при запуске.
USE_HTTPS=False

# Сколько секунд браузер помнит, что на этот адрес ходят только по https
# (HSTS). Читается только при USE_HTTPS=True.
#
# По умолчанию полгода. Пока сертификат обкатывается, поставьте 0: памяти
# нет, и вернуться к http можно в любой момент. Когда всё устоялось —
# верните 15552000. Снять уже выданную память до срока нельзя ничем, кроме
# настроек самого браузера, поэтому большой срок ставят последним шагом, а
# не первым.
HSTS_SECONDS=15552000

# Адреса, по которым сотрудники открывают систему. Нужны при USE_HTTPS=True:
# без них вход отвечает «подделка запроса». Указывать в точности, вместе с
# портом, если он не 443. Имя и адрес — разные записи, перечислите обе, если
# пользуются обеими.
CSRF_TRUSTED_ORIGINS=

# --- Письма на каждое событие ------------------------------------------------
#
# Писать ли ответственному при каждом падении остатка ниже минимума. По
# умолчанию нет: остаток пересчитывается при каждом проведении документа, и
# при десятке материалов набегает десяток писем в день — такой ящик перестают
# читать. Низкие остатки перечислены в ежедневной сводке (manage.py
# dailysummary) первым же разделом.
NOTIFY_LOW_STOCK_INSTANTLY=False

# --- Витрина за веб-сервером -------------------------------------------------
#
# Включайте, только если перед системой стоит nginx. Тогда настоящий адрес
# покупателя приходит в заголовке X-Forwarded-For, и по нему считается предел
# на число заказов в час. Без nginx заголовок подделывается кем угодно —
# предел обошёлся бы одной строкой в запросе.
TRUST_FORWARDED_FOR=False

DB_ENGINE=sqlite

# Читается только при DB_ENGINE=postgres
DB_NAME=warehouse_db
DB_USER=warehouse_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# ============================================================================
#  ПОЧТА ДЛЯ УВЕДОМЛЕНИЙ
# ============================================================================
#
# Система пишет ответственному сотруднику в двух случаях:
#   1. остаток материала упал ниже минимума;
#   2. инвентаризация выявила недостачи.
#
# По умолчанию письма никуда не уходят — печатаются в консоль. Для
# разработки этого достаточно. Настоящая отправка — см. SMTP_SETUP.md

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Кому приходят уведомления
WAREHOUSE_MANAGER_EMAIL=manager@leko.example
# От чьего имени отправляются
DEFAULT_FROM_EMAIL=warehouse@leko.example

# Для настоящей отправки раскомментируйте и заполните.
#
# Яндекс.Почта:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.yandex.ru
# EMAIL_PORT=465
# EMAIL_USE_SSL=True
# EMAIL_USE_TLS=False
# EMAIL_HOST_USER=sklad@yourcompany.ru
# EMAIL_HOST_PASSWORD=пароль_приложения
#
# Gmail (обычный пароль не подойдёт — нужен «пароль приложения»,
# создаётся на https://myaccount.google.com/apppasswords):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=sklad@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx


# ============================================================================
#  ПРОЧЕЕ
# ============================================================================

# Раздавать ли фотографии товаров силами Django.
#
# True  — когда перед приложением нет веб-сервера: обычный запуск,
#         офисный компьютер. Иначе витрина останется без картинок.
# False — когда впереди стоит nginx: он отдаёт файлы быстрее.
#         В docker compose выставляется само.
SERVE_MEDIA_FILES=True

# Порт, на котором nginx принимает запросы в docker compose
# HTTP_PORT=80
